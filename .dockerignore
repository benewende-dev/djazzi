# Djazzi images build from the repo root (apps/djazzi/packages/*/Dockerfile).
# Local installs and builds never enter the context: the image rebuilds them.
**/node_modules
**/dist
**/dist-headless
**/.env
.git
**/*.gif
# Native and packaged builds made on a developer's machine (the simulator's
# iOS project weighs over a gigabyte): no image uses them (02/10/2026).
apps/x/apps/mobile/ios
apps/x/apps/mobile/android
**/.expo
apps/x/apps/main/.package
apps/x/apps/main/out

# DJAZZI(17/10/2026): local checkouts and the private marketing kit are not build inputs.
.worktrees
marketing
# DJAZZI(28/11/2026): the skill library is rebuilt in the image (skill-library.py).
apps/djazzi/packages/instance/library
